# Copy to .env and fill in the REQUIRED values below. `.env` is gitignored and is the single
# source of truth for every secret and tunable — nothing secret is hardcoded in the application,
# docker-compose.yml, or CI.
#
# CONVENTION: a variable that has a safe built-in default in app/config.py is COMMENTED OUT here.
# Uncomment only to override. Never leave a variable present-but-empty (`FOO=`) unless it is one
# of the required ones below: pydantic-settings treats an empty value as an explicit empty string,
# not "unset", which is a startup crash for numeric fields rather than a fallback to the default.


# =============================================================================
# REQUIRED — the app will not work (or will refuse to boot) without these
# =============================================================================

# LLM backend. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Signs auth tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# An empty value is NOT a safe default: an empty HMAC key still produces valid-looking tokens, so
# anyone could forge one for any user. app/config.py therefore refuses to boot when
# ENV=staging/production unless this is set and >=32 chars; in development it generates a random
# ephemeral key per process instead (tokens won't survive a restart or span workers).
JWT_SECRET_KEY=

# Postgres password, used by docker-compose to both initialise the database and build
# DATABASE_URL. There is deliberately no default, so a deployment cannot silently inherit a
# well-known password. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# NOTE: Postgres only applies this when initialising an EMPTY data directory. To rotate it against
# an existing volume, run: docker compose exec postgres psql -U app -c "ALTER USER app WITH PASSWORD '<new>';"
POSTGRES_PASSWORD=


# =============================================================================
# Deployment environment
# =============================================================================

# development | staging | production. Gates the fail-fast checks on JWT_SECRET_KEY (above) and
# LangSmith tracing (below). Defaults to development.
ENV=development


# =============================================================================
# Observability — optional in development/staging, REQUIRED when ENV=production
# =============================================================================
# All three must be set together: the API key alone is a no-op, tracing only activates with
# LANGSMITH_TRACING=true. A production deployment refuses to start untraced.

# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# Use a distinct project per environment, e.g. product-query-agent-prod / -staging / -dev.
# LANGSMITH_PROJECT=product-query-agent-dev
# Override only for self-hosted or non-default LangSmith deployments.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# =============================================================================
# Infrastructure connections
# =============================================================================
# The defaults below target a HOST-run app (`uv run uvicorn ...`, `uv run main.py`).
# docker-compose.yml overrides these three with in-network service names, because container
# topology differs from the host — they are the only values compose overrides, and they are
# addresses rather than secrets. See the comment block in docker-compose.yml.

# SQLAlchemy URL. app/config.py normalises this on load: `postgres://` (what Render and Heroku
# hand out) and bare `postgresql://` are both rewritten to `postgresql+psycopg://`, so a provider's
# URL can be pasted in unchanged. It also derives the raw psycopg form the LangGraph
# checkpointer/store need.
# DATABASE_URL=sqlite:///./product_query_agent.db
# REDIS_URL=redis://localhost:6379/0
# Where the Streamlit frontend reaches the FastAPI backend.
# BACKEND_URL=http://localhost:8000

# Postgres bootstrap identity. Consumed by docker-compose to initialise the database and build
# DATABASE_URL; the application itself connects via DATABASE_URL. Declared on Settings so `.env`
# has no variable the application cannot account for.
# POSTGRES_USER=app
# POSTGRES_DB=product_query_agent


# =============================================================================
# Auth
# =============================================================================

# JWT_EXPIRE_MINUTES=30


# =============================================================================
# Models
# =============================================================================

# Conversational model driving the agent.
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.0

# Groq's published per-million-token rates for LLM_MODEL, used only to estimate cost for
# COST_BUDGET_USD_PER_USER_PER_DAY. Rates are model-specific — change these whenever you change
# LLM_MODEL, or the budget will be enforced against the wrong prices. Values below are
# openai/gpt-oss-120b ($0.15 in / $0.60 out); llama-3.3-70b-versatile was 0.59 / 0.79.
# LLM_INPUT_PRICE_PER_MILLION_USD=0.15
# LLM_OUTPUT_PRICE_PER_MILLION_USD=0.60

# Meta's Prompt Guard 2 jailbreak classifier, used by the guardrails middleware to catch injection
# phrasings the local regex patterns miss. Billed against a separate Groq quota from the chat
# model, so screening every turn does not consume the conversational token budget. Set
# PROMPT_GUARD_ENABLED=false to fall back to regex-only screening.
# PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# PROMPT_GUARD_ENABLED=true
# Score above which input is treated as an injection attempt (the model returns 0..1).
# PROMPT_GUARD_THRESHOLD=0.5
# PROMPT_GUARD_TIMEOUT_SECONDS=5.0


# =============================================================================
# Agent safety limits
# =============================================================================

# Max graph supersteps per request. Measured: 14 for a one-tool-call turn, ~6 per additional
# sequential call, so 30 allows roughly three. A loose limit lets a looping model burn tokens.
# MAX_RECURSION_LIMIT=30


# =============================================================================
# Per-user usage caps — five independent limits, whichever trips first
# =============================================================================

# Ships safe-by-default at $0.00: only cached answers are served until an operator raises this.
# MUST be raised for the agent to answer anything not already cached.
COST_BUDGET_USD_PER_USER_PER_DAY=0.0
# MAX_LLM_CALLS_PER_USER_PER_DAY=30
# 15, not ~5: a single conversational turn already costs 2-3 real LLM calls.
# MAX_LLM_CALLS_PER_MINUTE_PER_USER=15
# MAX_TOKENS_PER_USER_PER_DAY=30000
# The cap that most directly protects against tripping Groq's own tokens-per-minute quota.
# MAX_TOKENS_PER_MINUTE_PER_USER=4000

# ACCOUNT-WIDE, not per user — the only limit here that every user shares. The per-user caps above
# divide the provider's quota but never sum to it: enough users each staying under their own daily
# cap can still exhaust the account between them, and the provider then returns 429s that no
# app-level limit anticipated. Keep this below the provider's daily token quota for LLM_MODEL
# (openai/gpt-oss-120b allows 200k/day). Set 0 to disable the check.
# MAX_TOKENS_ALL_USERS_PER_DAY=180000


# =============================================================================
# Caching
# =============================================================================

# Redis: how long a final answer stays cached (scoped per user).
# RESPONSE_CACHE_TTL_SECONDS=300
# Postgres: how long a cached DummyJSON product/review row stays usable before it is refetched.
# Much longer than the answer cache because catalogue data changes slowly; a stale row is still
# served as a fallback when DummyJSON itself is unreachable.
# PRODUCT_CACHE_TTL_SECONDS=86400


# =============================================================================
# HTTP
# =============================================================================

# Comma-separated browser origins allowed to call the backend directly. Leave empty for the
# default setup: the Streamlit frontend calls the API server-side with `requests`, so the browser
# never makes a cross-origin request and CORS never applies. Set it only when a browser-based
# client (a React/JS app, or Swagger UI on another host) calls the API itself — to that client's
# origin, scheme and port included, no trailing slash: e.g. http://localhost:3000 or
# https://app.example.com.
# Note: setting this to `*` automatically disables credentialed CORS requests, since the
# wildcard+credentials combination is unsafe.
# CORS_ORIGINS=

# DummyJSON (the product data source) needs no API key or registration — it is fully public.
